# Single source of truth for the database credentials.
#
# POSTGRES_* initialise the database on first boot; DATABASE_URL is injected
# into rfd-api and rfd-processor and overrides the database_url in their config
# files. Keep the password identical in both places.
#
# Placeholder values — replace them before deploying anywhere real. Changing
# POSTGRES_PASSWORD after the volume has been initialised does not change the
# password in the database; it has to be altered in Postgres or the volume
# recreated.
POSTGRES_USER=rfd
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=rfd
DATABASE_URL=postgres://rfd:replace-me@postgres:5432/rfd
